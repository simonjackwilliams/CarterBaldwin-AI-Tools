function renderDraftMsg(tab) {
  const m = draftMsgs[tab];
  if (!m) return;
  document.getElementById('tab-label').textContent = TAB_LABELS[tab] || tab.toUpperCase();

  const subEl = document.getElementById('subject-line');
  if (m.subject) {
    subEl.style.display = 'block';
    document.getElementById('subject-text').textContent = m.subject;
  } else {
    subEl.style.display = 'none';
  }
  document.getElementById('message-body').textContent = m.body || '';
  const cb = document.getElementById('copy-btn');
  cb.textContent = 'COPY'; cb.classList.remove('copied');
}

function renderSubjectPicker(subjects) {
  if (!subjects?.length) { document.getElementById('subject-picker').style.display = 'none'; return; }
  document.getElementById('subject-picker').style.display = 'block';
  document.getElementById('subject-options').innerHTML = subjects.map((s, i) => `
