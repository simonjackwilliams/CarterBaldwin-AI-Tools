function copyMessage() {
  if (!draftMsgs?.[activeDraftTab]) return;
  const m = draftMsgs[activeDraftTab];
  const subjectShown = document.getElementById('subject-text').textContent;
  const text = (m.subject || subjectShown ? 'Subject: ' + (subjectShown || m.subject) + '\n\n' : '') + (m.body || '');
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('copy-btn');
    btn.textContent = 'COPIED'; btn.classList.add('copied');
    setTimeout(() => { btn.textContent = 'COPY'; btn.classList.remove('copied'); }, 2000);
  }).catch(() => {});
}

function clearDraft() {
  draftMsgs = null;
  document.getElementById('draft-results').style.display = 'none';
  document.getElementById('draft-empty').style.display = 'flex';
}

// ── EXTRACT TEXT FROM askClaude RESPONSE ──────────────────────────
function extractText(raw) {
  if (typeof raw === 'string') return raw;
  if (!raw || typeof raw !== 'object') return String(raw);
  // Handle {content: [{text: "..."}]} shape (standard Claude API)
  if (Array.isArray(raw.content) && raw.content[0]?.text) return raw.content[0].text;
  // Handle {content: "..."} shape
  if (typeof raw.content === 'string') return raw.content;
  // Handle {text: "..."} shape
  if (typeof raw.text === 'string') return raw.text;
  // Handle {response: "..."} shape
  if (typeof raw.response === 'string') return raw.response;
  // Last resort: serialize so we can at least see what came back
  return JSON.stringify(raw);
}

// ── HELPERS ───────────────────────────────────────────────────────
function fillList(id, items) {
  document.getElementById(id).innerHTML = (items || []).map(i => `<li>${escHtml(String(i))}</li>`).join('');
}
function showErr(elId, msg) { const el = document.getElementById(elId); el.textContent = msg; el.style.display = 'block'; }
function hideErr(elId) { document.getElementById(elId).style.display = 'none'; }
function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function escAttr(s) { return String(s).replace(/'/g,"\\'").replace(/"/g,'&quot;'); }

// ── MESSAGE GENERATION ─────────────────────────────────────────────────────
const SYS_MSG = `You are an executive search communication assistant for Carter Baldwin Executive Search. Your job is to draft professional, polished, natural-sounding messages — not robotic or generic AI-sounding text.

You draft emails, LinkedIn messages, client updates, candidate follow-ups, internal updates, and all other executive search communications.

Important rules:
- Do not invent facts not provided in the context
- Do not overpromise on timelines or outcomes
- Keep messages concise unless the context calls for more
- Avoid exaggerated or overly formal language
- Make it sound like it came from a thoughtful search professional
- Maintain confidentiality — do not include sensitive details unless provided
- Use [First Name], [Your Name], [Company], [Role Title], [Compensation Range] as placeholders when details are missing
- Preserve the consultant's intended meaning
- No markdown formatting in message bodies (no **, no #, no -)
- Use plain line breaks only

Generate 7 distinct message variants plus analysis. Return ONLY a valid JSON object — no markdown fences, no explanation.

JSON structure:
{
  "messageType": "Identified type e.g. Candidate Outreach — Cold",
  "subjectLines": ["Subject option 1", "Subject option 2", "Subject option 3", "Subject option 4"],
  "primaryDraft": { "subject": "...", "body": "..." },
  "shorter": { "subject": "...", "body": "..." },
  "warmer": { "subject": "...", "body": "..." },
  "direct": { "subject": "...", "body": "..." },
  "followUp": { "subject": "...", "body": "..." },
  "linkedinText": { "body": "3-6 sentences, no salutation, conversational register" },
  "finalDraft": { "subject": "...", "body": "..." },
  "keyPoints": ["key point included 1", "key point 2", "key point 3", "key point 4"],
  "possibleRisks": ["risk or concern to check before sending 1", "risk 2", "risk 3"]
}

Variant guidelines:
- primaryDraft: Standard professional version, clear structure
- shorter: 30-40% shorter, all key points still present
- warmer: More empathetic and personal, emphasizes the relationship, still professional
- direct: Gets to the point immediately — executive-appropriate brevity
- followUp: Reframed as a polite follow-up if no response, or natural next-step follow-up
- linkedinText: Short, conversational, suitable for LinkedIn DM or SMS — no formal salutation
- finalDraft: The single best, most polished version — this is the one the consultant should send

Common message type guidance:
- Candidate outreach: Introduce the role without overselling, make it easy to respond, do not reveal client unless appropriate
- Candidate follow-up after call: Thank for time, confirm next steps, keep it brief
- Candidate rejection: Be kind and direct, preserve the relationship, avoid unnecessary detail
- Client update: Focus on progress, market feedback, pipeline quality, next steps — make consultant look organized
- Weekly search update: Work completed, market feedback, pipeline status, challenges, next steps
- Compensation clarification: Professional and direct, avoid promises, use careful wording
- Slow process update: Honest without blaming the client, keep candidate interested, no overpromising
- Internal update: Short, direct, action-focused

keyPoints should list the specific information included in the messages.
possibleRisks should list anything the consultant should verify before sending: missing facts, sensitive wording, unconfirmed details, overpromising, tone concerns, confidentiality issues.`;

async function generateMessage() {
  const msgType = document.getElementById('msg-type').value;
  const recipient = document.getElementById('recipient').value;
  const tone = document.getElementById('tone').value;
  const context = document.getElementById('context').value.trim();

  hideErr('draft-error');
  if (!msgType) { showErr('draft-error', 'Please select a message type.'); return; }
  if (!context) { showErr('draft-error', 'Please add context — even a few sentences significantly improves output quality.'); return; }

  document.getElementById('gen-btn').disabled = true;
  document.getElementById('draft-empty').style.display = 'none';
  document.getElementById('draft-results').style.display = 'none';
  document.getElementById('draft-loading').style.display = 'flex';

  const userPrompt = `Message Type: ${msgType}
Recipient Type: ${recipient}
Tone Preference: ${tone}
Context: ${context}

Generate all variants, subject lines, key points, and risks.`;

  try {
    if (typeof window.cowork === 'undefined' || !window.cowork.askClaude) {
      throw new Error('Cowork environment required to run this tool.');
    }
    const raw = await window.cowork.askClaude(SYS_MSG + '\n\n' + userPrompt, []);
    const cleaned = extractText(raw).replace(/^```json\s*/m, '').replace(/\s*```\s*$/m, '').trim();
    draftMsgs = JSON.parse(cleaned);

    document.getElementById('draft-loading').style.display = 'none';
    document.getElementById('draft-results').style.display = 'flex';

    // Set badges
    document.getElementById('result-type-badge').textContent = (draftMsgs.messageType || msgType).toUpperCase();
    document.getElementById('result-recipient-badge').textContent = recipient.toUpperCase();

    // Reset tabs to Send-Ready
    document.querySelectorAll('#draft-results .tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelector('[data-tab="finalDraft"]').classList.add('active');
    activeDraftTab = 'finalDraft';
    document.getElementById('message-card').style.display = 'block';
    document.getElementById('analysis-panel').style.display = 'none';

    // Render subject picker
    renderSubjectPicker(draftMsgs.subjectLines);

    renderDraftMsg('finalDraft');
    renderDraftAnalysis();

  } catch (e) {
    document.getElementById('draft-loading').style.display = 'none';
    document.getElementById('draft-empty').style.display = 'flex';
    showErr('draft-error', 'Generation failed: ' + e.message);
  } finally {
    document.getElementById('gen-btn').disabled = false;
  }
}

// ── SEARCH PROGRESS ────────────────────────────────────────────────────────
const SYS_PROG = `You are a senior executive search advisor at Carter Baldwin Executive Search. Analyze the search progress against the 49-day benchmark and produce a comprehensive assessment.

49-Day Framework:
- Days 1–7: Kickoff & Position Profiling
- Days 8–14: Research & Target Identification
- Days 15–21: Initial Outreach
- Days 22–28: Screening & Assessment
- Days 29–35: Shortlist Development
- Days 36–42: Client Interviews
- Days 43–49: Offer & Close

Loxo Pipeline Benchmarks: Targets 80-150, Prospects 40-80, Engaged 15-30, Evaluating 8-15, Candidates 5-10, Semi-Finalists 3-6, Finalists 2-4.

Return ONLY valid JSON:
{
  "assessment": { "summary": "2-3 sentence overall health assessment", "health": "On Track|At Risk|Off Track|Extended", "daysElapsed": number, "currentPhase": "..." },
  "milestones": [{ "name": "...", "status": "complete|in-progress|pending|overdue", "note": "..." }],
  "pipelineHealth": { "summary": "...", "stages": [{ "stage": "Targets", "count": 0, "benchmark": "80-150", "health": "good|warning|critical", "note": "..." }] },
  "sevenDayPlan": [{ "timeframe": "Days 1-2", "action": "...", "owner": "Lead Consultant|Search Team|Client", "priority": "high|medium|low" }],
  "clientEmail": { "subject": "...", "body": "full ready-to-send email" },
  "internalUpdate": "2-3 paragraph direct internal update",
  "strategyRecommendations": ["recommendation 1", "recommendation 2", "recommendation 3", "recommendation 4"]
}`;

async function analyzeSearch() {
  const client = document.getElementById('p-client').value.trim();
  const role = document.getElementById('p-role').value.trim();
  const kickoff = document.getElementById('p-kickoff').value;
  const today = document.getElementById('p-today').value;
  const consultant = document.getElementById('p-consultant').value.trim();
  const meeting = document.getElementById('p-meeting').value;
  const stage = document.getElementById('p-stage').value;
  const context = document.getElementById('p-context').value.trim();

  const loxo = {
    targets: parseInt(document.getElementById('lx-targets').value) || 0,
    prospects: parseInt(document.getElementById('lx-prospects').value) || 0,
    engaged: parseInt(document.getElementById('lx-engaged').value) || 0,
    evaluating: parseInt(document.getElementById('lx-evaluating').value) || 0,
    candidates: parseInt(document.getElementById('lx-candidates').value) || 0,
    semifinalists: parseInt(document.getElementById('lx-semifinalists').value) || 0,
    finalists: parseInt(document.getElementById('lx-finalists').value) || 0,
    declined: parseInt(document.getElementById('lx-declined').value) || 0,
  };

  hideErr('prog-error');
  if (!client || !role) { showErr('prog-error', 'Please enter a client name and role title.'); return; }

  let daysElapsed = 0;
  if (kickoff && today) {
    daysElapsed = Math.max(0, Math.round((new Date(today) - new Date(kickoff)) / 86400000));
  }

  const fileContext = uploadedFiles.length
    ? '\n\nAttached Documents:\n' + uploadedFiles.map(f => `--- ${f.name} ---\n${f.text.slice(0, 2000)}`).join('\n\n')
    : '';

  const userPrompt = `Analysis Focus: ${activeFocus}

Search Details:
- Client: ${client}
- Role: ${role}
- Lead Consultant: ${consultant || 'Not specified'}
- Kickoff Date: ${kickoff || 'Not specified'}
- Today's Date: ${today || 'Not specified'}
- Days Elapsed: ${daysElapsed}
- Current Stage: ${stage || 'Not specified'}
- Next Client Meeting: ${meeting || 'Not scheduled'}

Loxo Pipeline:
- Targets: ${loxo.targets} | Prospects: ${loxo.prospects}
- Engaged: ${loxo.engaged} | Evaluating: ${loxo.evaluating}
- Candidates: ${loxo.candidates} | Semi-Finalists: ${loxo.semifinalists}
- Finalists: ${loxo.finalists} | Declined: ${loxo.declined}

${context ? 'Context & Notes:\n' + context : ''}${fileContext}`;

  document.getElementById('analyze-btn').disabled = true;
  document.getElementById('prog-empty').style.display = 'none';
  document.getElementById('prog-results').style.display = 'none';
  document.getElementById('prog-loading').style.display = 'flex';

  try {
    if (typeof window.cowork === 'undefined' || !window.cowork.askClaude) throw new Error('Cowork environment required.');
    const raw = await window.cowork.askClaude(SYS_PROG + '\n\n' + userPrompt, []);
    const cleaned = extractText(raw).replace(/^```json\s*/m, '').replace(/\s*```\s*$/m, '').trim();
    const result = JSON.parse(cleaned);

    document.getElementById('prog-loading').style.display = 'none';
    renderProgressResults(result, client, role);
    document.getElementById('prog-results').style.display = 'flex';

  } catch (e) {
    document.getElementById('prog-loading').style.display = 'none';
    document.getElementById('prog-empty').style.display = 'block';
    showErr('prog-error', 'Analysis failed: ' + e.message);
  } finally {
    document.getElementById('analyze-btn').disabled = false;
  }
}

function renderProgressResults(r, client, role) {
  const wrap = document.getElementById('prog-results');
  wrap.innerHTML = '';

  const healthColors = { 'On Track':'#15803D','At Risk':'#B45309','Off Track':'#DC2626','Extended':'#7C3AED' };
  const healthBgs   = { 'On Track':'#DCFCE7','At Risk':'#FEF3C7','Off Track':'#FEF2F2','Extended':'#EDE9FE' };
  const health = r.assessment?.health || 'On Track';

  wrap.innerHTML += `
    <div class="pcard">
      <div class="pcard-header">
        <span class="pcard-title">Search Assessment — ${escHtml(client)}: ${escHtml(role)}</span>
        <span style="font-size:11px;font-weight:700;color:${healthColors[health]||'#15803D'};background:${healthBgs[health]||'#DCFCE7'};padding:3px 10px;border-radius:12px;">${health}</span>
      </div>
      <div class="pcard-body">
        <p>${escHtml(r.assessment?.summary || '')}</p>
        <p style="margin-top:8px;font-size:12px;color:#AAA;">Day ${r.assessment?.daysElapsed ?? '?'} · ${escHtml(r.assessment?.currentPhase || '')}</p>
      </div>
    </div>`;

  if (r.milestones?.length) {
    const msHtml = r.milestones.map(m => {
      const dc = {complete:'ms-complete','in-progress':'ms-progress',pending:'ms-pending',overdue:'ms-overdue'}[m.status]||'ms-pending';
      const sc = {complete:'complete','in-progress':'progress',pending:'pending',overdue:'overdue'}[m.status]||'pending';
      const sl = {complete:'Complete','in-progress':'In Progress',pending:'Pending',overdue:'Overdue'}[m.status]||m.status;
      return `<div class="milestone-item">
        <div class="ms-dot ${dc}"></div>
        <span class="ms-name">${escHtml(m.name)}${m.note?'<span style="color:#AAA;font-size:11px;"> — '+escHtml(m.note)+'</span>':''}</span>
        <span class="ms-status ${sc}">${sl}</span>
      </div>`;
    }).join('');
    wrap.innerHTML += `<div class="pcard"><div class="pcard-header"><span class="pcard-title">49-Day Milestone Status</span></div><div class="pcard-body"><div class="milestone-list">${msHtml}</div></div></div>`;
  }

  if (r.pipelineHealth) {
    const maxCount = Math.max(...(r.pipelineHealth.stages||[]).map(s=>s.count||0),1);
    const bc = {good:'#15803D',warning:'#B45309',critical:'#DC2626'};
    const stagesHtml = (r.pipelineHealth.stages||[]).map(s=>`
      <div class="stage-row">
        <div class="stage-meta"><span class="stage-name">${escHtml(s.stage)}</span><span class="stage-count">${s.count} <span style="color:#CCC">/ ${s.benchmark}</span></span></div>
        <div class="stage-bar-bg"><div class="stage-bar-fill" style="width:${Math.round(((s.count||0)/maxCount)*100)}%;background:${bc[s.health]||'#E85D2A'};"></div></div>
        ${s.note?'<div class="stage-note">'+escHtml(s.note)+'</div>':''}
      </div>`).join('');
    wrap.innerHTML += `<div class="pcard"><div class="pcard-header"><span class="pcard-title">Loxo Pipeline Health</span></div><div class="pcard-body"><p style="margin-bottom:16px;">${escHtml(r.pipelineHealth.summary||'')}</p><div class="pipeline-stages">${stagesHtml}</div></div></div>`;
  }

  if (r.sevenDayPlan?.length) {
    const pc = {high:'priority-high',medium:'priority-medium',low:'priority-low'};
    const planHtml = r.sevenDayPlan.map(d=>`
      <div class="plan-day">
        <span class="plan-day-badge ${pc[d.priority]||'priority-medium'}">${escHtml(d.timeframe||'')}</span>
        <div class="plan-day-content">
          <div class="plan-day-action">${escHtml(d.action)}</div>
          ${d.owner?'<div class="plan-day-owner">Owner: '+escHtml(d.owner)+'</div>':''}
        </div>
      </div>`).join('');
    wrap.innerHTML += `<div class="pcard"><div class="pcard-header"><span class="pcard-title">7-Day Action Plan</span></div><div class="pcard-body"><div class="plan-days">${planHtml}</div></div></div>`;
  }

  if (r.clientEmail) {
    const eid = 'copy-client-email';
    wrap.innerHTML += `
      <div class="pcard">
        <div class="pcard-header"><span class="pcard-title">Client Update Email — Ready to Send</span><button class="copy-btn" id="${eid}" onclick="copyText('${eid}',${JSON.stringify('Subject: '+(r.clientEmail.subject||'')+'\n\n'+(r.clientEmail.body||''))})">COPY</button></div>
        <div class="email-subject">SUBJECT — <strong>${escHtml(r.clientEmail.subject||'')}</strong></div>
        <div class="email-body-text">${escHtml(r.clientEmail.body||'')}</div>
      </div>`;
  }

  if (r.internalUpdate) {
    const iid = 'copy-internal';
    wrap.innerHTML += `
      <div class="pcard">
        <div class="pcard-header"><span class="pcard-title">Internal Team Update</span><button class="copy-btn" id="${iid}" onclick="copyText('${iid}',${JSON.stringify(r.internalUpdate)})">COPY</button></div>
        <div class="pcard-body" style="border-left:3px solid #111;margin:0 18px;padding:16px 0 16px 16px;"><p style="white-space:pre-wrap;">${escHtml(r.internalUpdate)}</p></div>
      </div>`;
  }

  if (r.strategyRecommendations?.length) {
    wrap.innerHTML += `<div class="pcard"><div class="pcard-header"><span class="pcard-title">Strategy &amp; Search Recommendations</span></div><div class="pcard-body"><ul class="alist">${r.strategyRecommendations.map(rec=>`<li>${escHtml(rec)}</li>`).join('')}</ul></div></div>`;
  }
}

function copyText(btnId, text) {
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.textContent = 'COPIED'; btn.classList.add('copied');
    setTimeout(() => { btn.textContent = 'COPY'; btn.classList.remove('copied'); }, 2000);
  }).catch(() => {});
}
</script>
