function handleDragOver(e) { e.preventDefault(); document.getElementById('dropzone').classList.add('drag-over'); }
function handleDragLeave() { document.getElementById('dropzone').classList.remove('drag-over'); }
function handleDrop(e) { e.preventDefault(); document.getElementById('dropzone').classList.remove('drag-over'); handleFiles(e.dataTransfer.files); }
function handleFiles(files) {
  Array.from(files).forEach(file => {
    const reader = new FileReader();
    reader.onload = (e) => { uploadedFiles.push({ name: file.name, text: e.target.result }); renderFileList(); };
    reader.readAsText(file);
  });
}
function removeFile(idx) { uploadedFiles.splice(idx, 1); renderFileList(); }
function renderFileList() {
  document.getElementById('file-list').innerHTML = uploadedFiles.map((f, i) =>
    `<div class="file-item"><span>${f.name}</span><button onclick="removeFile(${i})">×</button></div>`
  ).join('');
}

// ── DRAFT TAB SWITCHING ───────────────────────────────────────────
const TAB_LABELS = {
  finalDraft: 'SEND-READY VERSION',
  primaryDraft: 'PRIMARY DRAFT',
  shorter: 'SHORTER VERSION',
  warmer: 'WARMER VERSION',
  direct: 'MORE DIRECT VERSION',
  followUp: 'FOLLOW-UP VERSION',
  linkedinText: 'LINKEDIN / TEXT VERSION',
};

function switchDraftTab(btn) {
  const tab = btn.dataset.tab;
  activeDraftTab = tab;
  document.querySelectorAll('#draft-results .tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');

  const isAnalysis = tab === 'analysis';
  document.getElementById('message-card').style.display = isAnalysis ? 'none' : 'block';
  document.getElementById('analysis-panel').style.display = isAnalysis ? 'block' : 'none';

  // Show subject picker only on email-type tabs (not linkedin, not analysis)
  const showPicker = !isAnalysis && tab !== 'linkedinText' && draftMsgs?.subjectLines?.length;
  document.getElementById('subject-picker').style.display = showPicker ? 'block' : 'none';

  if (!isAnalysis && draftMsgs) renderDraftMsg(tab);
